+<!--
+  Diese Komponente stellt die Seite zur Änderung des Benutzerpassworts bereit
+  Sie wird von eingeloggten Nutzern verwendet, um ihr Passwort zu aktualisieren
+  Es werden zwei Felder benötigt: das aktuelle Passwort und das neue
+  Die Eingaben werden an das Backend geschickt, mit Ladeanzeige, Erfolgsmeldung und Fehlerbehandlung.
+-->
+
+<script lang="ts" setup>
+
+import { ref } from 'vue' // Die Funktion `ref` wird importiert, um reaktive Variablen zu erstellen
+import api from '@/api' // Die zentrale API-Schnittstelle wird importiert
+import { useRouter } from 'vue-router' // Die Routerfunktion wird importiert, um Seitenübergänge durchzuführen
+
+const router = useRouter() // Diese Instanz wird verwendet, um nach erfolgreicher Änderung zur Einstellungsseite zurückzuleiten
+
+const currentPassword = ref('') // In dieser Variable wird das aktuell eingegebene Passwort gespeichert
+const newPassword = ref('') // In dieser Variable wird das neue gewünschte Passwort gespeichert
+const isLoading = ref(false) // Diese Variable zeigt an, ob die Anfrage zur Passwortänderung aktuell verarbeitet wird
+const errorMessage = ref('') // Diese Variable speichert eine eventuell auftretende Fehlermeldung
+const successMessage = ref('') // Diese Variable speichert eine Erfolgsmeldung nach erfolgreicher Passwortänderung
+
+
+// Diese Funktion wird aufgerufen, wenn der Benutzer das Formular absendet
+const onChangePassword = async () => {
+  if (!currentPassword.value || !newPassword.value) { // Hier wird es geprüft, ob beide Passwortfelder ausgefüllt sind
+    errorMessage.value = 'Bitte beide Passwörter eingeben.' // Wenn nicht, wird eine Fehlermeldung angezeigt
+    return
+  }
+
+  isLoading.value = true // Die Ladeanzeige wird aktiviert
+
+  // Alte Fehlermeldungen und Erfolgsmeldungen werden zurückgesetzt
+  errorMessage.value = ''
+  successMessage.value = ''
+
+  try {
+    // Die Passwortdaten werden an das Backend gesendet
+    await api.changePassword({
+      currentPassword: currentPassword.value,
+      newPassword: newPassword.value,
+    })
+
+    
+    successMessage.value = 'Passwort erfolgreich geändert!' // Bei Erfolg wird eine Bestätigung angezeigt
+
+    // Das aktuelle und neue Passwortfeld werden geleert
+    currentPassword.value = ''
+    newPassword.value = ''
+
+    setTimeout(() => router.push('/settings'), 1500) // Nach kurzer Wartezeit wird zur Einstellungsseite weitergeleitet
+  
+  // Falls ein Fehler vom Backend zurückkommt, wird eine entsprechende Meldung angezeigt
+  } catch (e: any) {
+    errorMessage.value = e?.response?.data?.message || 'Fehler beim Ändern des Passworts.'
+ 
+ 
+ 
+  } finally {
+    isLoading.value = false // Unabhängig vom Ergebnis wird die Ladeanzeige wieder deaktiviert
+  }
+}
+</script>
+
+
+<template>
+  <div class="settings-page">
+    <div class="container page">
+      <div class="row">
+        <div class="col-md-6 offset-md-3 col-xs-12">
+          <h1 class="text-xs-center">Passwort ändern</h1>
+
+          <!-- Hier wird eine Fehlermeldung angezeigt, wenn beim Speichern ein Fehler auftritt -->
+          <div v-if="errorMessage" class="alert alert-danger">{{ errorMessage }}</div>
+
+          <!-- Hier wird eine Erfolgsmeldung angezeigt, nachdem das Passwort erfolgreich geändert wurde -->
+          <div v-if="successMessage" class="alert alert-success">{{ successMessage }}</div>
+
+          <!-- Hier wird ein Formular angezeigt, mit dem der Nutzer ein neues Passwort eingeben kann -->
+          <form @submit.prevent="onChangePassword">
+            
+            <!-- das ist das Eingabefeld für das aktuelle Passwort -->
+            <fieldset class="form-group">
+
+              <!-- Der eingegebene Wert wird in `currentPassword` gespeichert -->
+              <input
+                v-model="currentPassword"
+                type="password"
+                class="form-control form-control-lg"
+                placeholder="Aktuelles Passwort"
+                required
+              />
+            </fieldset>
+
+            <!-- das ist das Eingabefeld für das neue Passwort -->
+            <fieldset class="form-group">
+
+              <!-- Der eingegebene Wert wird in `newPassword` gespeichert -->
+              <input
+                v-model="newPassword"
+                type="password"
+                class="form-control form-control-lg"
+                placeholder="Neues Passwort"
+                required
+              />
+            </fieldset>
+            
+            <!-- Sobald der Nutzer den Button klickt, wird das neue Passwort + alte Passwort an das Backend gesendet
+            und während die Anfrage läuft, wird der Button deaktiviert, um Doppelanfragen zu verhindern -->
+            <button class="btn btn-lg btn-warning pull-xs-right" :disabled="isLoading">
+              Passwort ändern
+            </button>
+          </form>
+        </div>
+      </div>
+    </div>
+  </div>
+</template>
