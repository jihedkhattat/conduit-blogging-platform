+﻿using System.Security.Cryptography;
+using System.Text;
+
+namespace Realworlddotnet.Api.Utils;
+
+// Die klasse PasswordHasher stellt Methoden zum Hashen, Salten und Verifizieren von Passwörtern bereit, sie wird verwendet, um Benutzerpasswörter nicht im Klartext zu speichern 
+public static class PasswordHasher
+{
+
+    // Diese Methode generiert einen zufälligen Salt-Wert, der später zum Hashing des Passworts verwendet wird
+    public static string GenerateSalt()
+    {
+        var saltBytes = new byte[16]; // Der Salt besteht aus 16 Bytes
+        using (var rng = RandomNumberGenerator.Create()) // Hier wird ein kryptografisch sicherer Zufallsgenerator verwendet
+        {
+            rng.GetBytes(saltBytes); // Dann werden die Bytes mit Zufallswerten gefüllt
+        }
+        return Convert.ToBase64String(saltBytes); // und der Salt wird in eine lesbare Zeichenkette umgewandelt
+    }
+
+    // Diese Methode erzeugt aus einem Passwort und einem Salt einen Hash
+    public static string HashPassword(string password, string salt)
+    {
+        var combined = Encoding.UTF8.GetBytes(password + salt); // Zuerst werden Passwort und Salt zusammengeführt und in Bytes umgewandelt
+        using (var sha256 = SHA256.Create()) // dann wird SHA-256 als Hashing-Algorithmus verwendet
+        {
+            var hash = sha256.ComputeHash(combined); // Der kombinierte Byte-Array wird gehasht
+            return Convert.ToBase64String(hash); // und das Ergebnis wird in eine Zeichenkette umgewandelt
+        }
+    }
+
+    // Diese Methode prüft, ob ein eingegebenes Passwort dem in der Datenbank gespeicherten Hash entsprich
+    public static bool VerifyPassword(string enteredPassword, string storedHash, string storedSalt)
+    {
+        // Dazu wird das eingegebene Passwort mit dem gespeicherten Salt erneut gehasht und mit dem gespeicherten Hash verglichen
+        var hashOfEntered = HashPassword(enteredPassword, storedSalt);
+        return hashOfEntered == storedHash;
+    }
+
+}
