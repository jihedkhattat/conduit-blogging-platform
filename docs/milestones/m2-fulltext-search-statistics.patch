+<!--
+  Diese Komponente implementiert die Seite für die Volltextsuche.
+  Sie ermöglicht es Nutzern, ein oder mehrere Schlüsselwörter einzugeben, 
+  eine Suchanfrage an das Backend zu senden 
+  und die passenden Artikel in einem Feed-ähnlichen Layout anzuzeigen. 
+  Sie umfasst:
+  - Eingabevalidierung und Authentifizierungsprüfung,
+  - Lade- und Fehlerbehandlung,
+  - Seitennummerierung (Pagination),
+  - und Echtzeit-Anzeige der Suchergebnisse.
+-->
+
+<template>
+  <div class="container">
+    <div class="search-box">
+
+
+   <!-- 1/6- Erfasst die Eingabe des Benutzers und startet die Suche,
+   wenn auf den Button geklickt oder die Eingabetaste gedrückt wird.-->
+<!--------------------------------------------------------------->
+      <input
+        v-model="searchQuery"
+        @keyup.enter="startNewSearch"
+        placeholder="Gib ein oder mehrere Suchbegriffe ein"
+      />
+      <button @click="startNewSearch">Suchen</button>
+    </div>
+<!--------------------------------------------------------------->
+
+
+
+    <!-- Zeigt eine Fehlermeldung an, falls ein Fehler (z. B. keine Eingabe oder 401) vorliegt -->
+    <!------------------------------------------>
+    <div v-if="errorMessage" class="error-message">
+      {{ errorMessage }} <!-- Gibt den Text der Fehlermeldung aus -->
+    </div>
+    <!------------------------------------------>
+
+
+
+    <!-- Zeigt einen Ladehinweis während der Anfrage an -->
+    <!------------------------------------------>
+    <div v-if="isLoading" class="loading">
+      <p>Suche läuft...</p> <!-- Hinweistext, dass gesucht wird -->
+    </div>
+    <!------------------------------------------>
+
+
+
+    <!-- Zeigt die Anzahl der gefundenen Artikel nach einer erfolgreichen Suche -->
+    <!------------------------------------------>
+    <div v-if="searchPerformed && articlesCount > 0" class="search-summary">
+      <p><strong>{{ articlesCount }}</strong> Artikel gefunden.</p> <!-- Gibt die Trefferanzahl aus -->
+    </div>
+    <!------------------------------------------>
+
+
+
+
+    <!-- 6/6- Artikelvorschau -->
+  <!--------------------------------------------------------------->
+  <!--Zeigt jede Artikelvorschau im gleichen Design wie die bestehenden Artikelübersichten an -->
+    <div v-if="articles.length > 0">
+      <ArticlePreview
+        v-for="article in articles"
+        :key="article.slug"
+        :article="article"
+      />
+  <!--------------------------------------------------------------->
+
+
+
+    <!-- Anzeige der Paginierung unter den Suchergebnissen -->
+    <!------------------------------------------>
+      <div class="pagination">
+        <button @click="prevPage" :disabled="currentPage === 1">Zurück</button>
+        <span>Seite {{ currentPage }} von {{ totalPages }}</span>
+        <button @click="nextPage" :disabled="currentPage === totalPages">Weiter</button>
+      </div>
+    </div>
+    <!------------------------------------------>
+
+
+
+
+    <!-- Zeigt eine Nachricht an, wenn keine Artikel gefunden wurden -->
+    <!------------------------------------------>
+    <div v-else-if="searchPerformed && !isLoading && articles.length === 0">
+      <p>Keine Artikel gefunden.</p>
+    </div>
+    <!------------------------------------------>
+    
+  </div>
+</template>
+
+
+
+
+<script setup lang="ts">
+//Script-Bereich zur Steuerung der Suchlogik, der Datenverwaltung und der Benutzerinteraktion
+//------------------------------------------
+import ArticlePreview from '@/components/ArticlePreview.vue' // Komponente zur Darstellung eines Artikels
+import { ref, computed } from 'vue' // Reaktive Daten und berechnete Werte
+import { useUserStore } from '@/stores/useUserStore' // Zugriff auf Benutzerdaten und Authentifizierung
+
+const searchQuery = ref('') // Eingabe des Suchbegriffs
+const articles = ref<any[]>([]) // Liste der gefundenen Artikel
+const searchPerformed = ref(false) // Kennzeichnet, ob eine Suche durchgeführt wurde
+const articlesCount = ref(0) // Gesamtanzahl der gefundenen Artikel
+const limit = 10 // Anzahl der Artikel pro Seite
+const currentPage = ref(1) // Aktuell angezeigte Seite
+
+const isLoading = ref(false) // Anzeige, ob eine Suche gerade läuft
+const errorMessage = ref('') // Text für eventuelle Fehlermeldungen
+
+const userStore = useUserStore() // Zugriff auf Login-Daten (Token etc.)
+const totalPages = computed(() => Math.ceil(articlesCount.value / limit)) // Berechnet Seitenanzahl für Paginierung
+
+const startNewSearch = () => { // Startet eine neue Suche auf Seite 1
+  currentPage.value = 1
+  performSearch()
+}
+//------------------------------------------
+
+
+
+// 2/6- Such-Start
+//------------------------------------------------------------------
+const performSearch = async () => {
+  errorMessage.value = '' // Frühere Fehlermeldungen werden gelöscht
+  searchPerformed.value = false // searchPerformed wird auf false zurückgesetzt
+
+  if (!searchQuery.value.trim()) {
+    errorMessage.value = 'Bitte gib ein Suchwort ein.'
+    return // Die Eingabe wird geprüft (darf nicht leer sein)
+  }
+
+  if (!userStore.userInfo?.token) {
+    errorMessage.value = 'Nicht autorisiert. Bitte logge dich ein.'
+    return // Es wird überprüft, ob der Benutzer eingeloggt ist (Token muss vorhanden sein)
+  }
+  //------------------------------------------------------------------
+
+
+
+
+  // 3/6- Anfragevorbereitung
+  //------------------------------------------------------------------
+  const queryParam = encodeURIComponent(searchQuery.value.trim().replace(/\s+/g, '+')) // Formatiert die Suchanfrage (Leerzeichen → '+') und kodiert sie für die URL
+  const offset = (currentPage.value - 1) * limit // Berechnet den Offset basierend auf der aktuellen Seite für die Seitennummerierung (Paginierung)
+  //------------------------------------------------------------------
+
+
+
+  isLoading.value = true
+
+  try {
+    //4/6- Backend-API-Aufruf
+    //------------------------------------------------------------------
+    const response = await fetch(`http://localhost:8081/api/articles/search?query=${queryParam}&limit=${limit}&offset=${offset}`, { // Sendet eine GET-Anfrage an den Such-Endpunkt
+      headers: {
+        Authorization: `Bearer ${userStore.userInfo.token}`, // Sicherstellt nur eingeloggte Nutzer dürfen suchen
+        Accept: 'application/json'
+      }
+    //------------------------------------------------------------------
+    })
+
+
+
+    // Behandlung für den Fall, dass der Benutzer nicht authentifiziert ist (HTTP-Status 401)
+    //------------------------------------------
+    if (response.status === 401) {
+      errorMessage.value = 'Nicht autorisiert. Bitte logge dich ein.' // Fehlermeldung setzen
+      articles.value = [] // Artikel zurücksetzen
+      articlesCount.value = 0 // Trefferanzahl zurücksetzen
+      searchPerformed.value = true // Suche wurde durchgeführt, auch wenn keine Ergebnisse
+      return
+    }
+    //------------------------------------------
+
+
+
+    // Allgemeine Fehlerbehandlung bei fehlgeschlagener Serverantwort
+    //------------------------------------------
+    if (!response.ok) {
+      const errorText = await response.text() // Lese den Fehlertext aus der Antwort
+      errorMessage.value = 'Ein Fehler ist aufgetreten: ' + errorText // Zeige den Fehler im UI
+      articles.value = [] // Artikel zurücksetzen
+      articlesCount.value = 0 // Trefferanzahl zurücksetzen
+      searchPerformed.value = true // Suche wurde durchgeführt
+      return
+    }
+    //------------------------------------------
+
+
+
+
+
+    // 5/6- Verarbeitung der Backend-Antwort
+    //------------------------------------------------------------------
+    // Liest die JSON-Antwort aus und speichert Artikel sowie Gesamtanzahl für Anzeige und Paginierung
+    const result = await response.json()
+    articles.value = result.articles
+    articlesCount.value = result.articlesCount
+    searchPerformed.value = true
+    //------------------------------------------------------------------
+
+
+  // Fehlerbehandlung für Netzwerkprobleme oder unerwartete Fehler
+  //------------------------------------------
+  } catch (err) {
+    errorMessage.value = 'Netzwerkfehler. Bitte versuche es später erneut.' // Zeigt eine allgemeine Fehlermeldung bei z. B. Verbindungsproblemen
+  }
+  //------------------------------------------
+
+
+  // Wird immer ausgeführt, unabhängig vom Erfolg oder Fehler der Anfrage
+  //------------------------------------------
+  finally {
+    isLoading.value = false // Setzt den Ladezustand zurück, damit die Ladeanzeige verschwindet
+  }
+  //------------------------------------------
+
+}
+
+
+// Erhöht die aktuelle Seite, wenn noch weitere Seiten verfügbar sind, und startet die neue Suche
+//------------------------------------------------------------------
+const nextPage = () => {
+  if (currentPage.value < totalPages.value) {
+    currentPage.value++
+    performSearch()
+  }
+}
+//------------------------------------------------------------------
+
+
+
+// Verringert die aktuelle Seite, wenn man sich nicht auf Seite 1 befindet, und startet die neue Suche
+//------------------------------------------------------------------
+const prevPage = () => {
+  if (currentPage.value > 1) {
+    currentPage.value--
+    performSearch()
+  }
+}
+//------------------------------------------------------------------
+
+
+
+</script>
+
+<!-- CSS-Styles für das Layout und die Darstellung der Suchseite -->
+<!------------------------------------------>
+<style scoped>
+/* Stil für das Eingabefeld und den Button */
+.search-box {
+  display: flex; /* Elemente nebeneinander */
+  gap: 1rem; /* Abstand zwischen Input und Button */
