+
+
+    // Hier wird eine Liste aller Artikel aus der Datenbank geladen,
+    // sodass sie für Volltextsuche verwendet werden kann
+    public async Task<List<Article>> GetAllArticlesAsync(CancellationToken cancellationToken)
+    {
+        return await _context.Articles
+            .Include(x => x.Author) // Hier wird der Autor direkt mitgeladen
+            .Include(x => x.Tags)   // Hier werden die Tags direkt mitgeladen
+            .AsNoTracking()         // Hier wird das Ergebnis ohne Tracking geladen, sodass keine Änderungen verfolgt werden
+            .ToListAsync(cancellationToken);
+    }
+
+
+    // Hier wird ein bestimmter Suchbegriff aus der Tabelle SearchCounts gelesen,
+    // sodass die aktuelle Anzahl der bisherigen Suchanfragen zu diesem Begriff ermittelt werden kann
+    public async Task<SearchCount?> GetSearchCountAsync(string keywordId, CancellationToken cancellationToken)
+    {
+        return await _context.SearchCounts.FindAsync(new object[] { keywordId }, cancellationToken);
+    }
+
+
+    // Hier wird ein neuer Eintrag in der Tabelle SearchCounts hinzugefügt,
+    // sodass ein neuer Suchbegriff mit Zähler 1 gespeichert wird
+    public void AddSearchCount(SearchCount entry)
+    {
+        _context.SearchCounts.Add(entry);
+    }
+
+
+    // Hier wird eine gesamte Suchanfrage verarbeitet und die enthaltenen Schlüsselwörter extrahiert,
+    // sodass sie jeweils einzeln und auch kombiniert gezählt werden können
+    public async Task SaveSearchKeywordsAsync(string query, CancellationToken cancellationToken)
+    {
+        // Hier wird überprüft, ob die Suchanfrage leer ist,
+        // sodass leere oder ungültige Eingaben ignoriert werden
+        if (string.IsNullOrWhiteSpace(query))
+            return;
+
+        // Hier wird die Suchanfrage in einzelne Wörter zerlegt und bereinigt,
+        // sodass sie als einzelne Keywords gespeichert werden können
+        var keywords = query.Split('+', StringSplitOptions.RemoveEmptyEntries) // Hier wird die Query bei "+" getrennt, sodass mehrere Begriffe einzeln verarbeitet werden
+
+                             .Select(k => k.Trim()) // Hier wird jeder Begriff getrimmt, sodass unnötige Leerzeichen entfernt werden
+
+                             .Where(k => !string.IsNullOrWhiteSpace(k)) // Hier werden leere Begriffe entfernt, sodass nur sinnvolle Wörter bleibe
+
+                             .Distinct() // Hier wird jeder Begriff nur einmal behalten, sodass Dopplungen vermieden werden
+                            
+                            // Hier werden die Begriffe sortiert, sodass sie einheitlich gespeichert werden
+                             .OrderBy(k => k)
+                             .ToList();
+
+        // Hier wird abgebrochen, wenn keine gültigen Begriffe übrig sind, sodass nichts gespeichert wird
+        if (!keywords.Any())
+            return;
+
+
+        // Hier wird die kombinierte Keyword-Suchanfrage erstellt,
+        // sodass auch Kombinationen (wort1+wort2) gezählt werden können
+        var fullKeywordId = string.Join("+", keywords);
+        var allKeywordIds = keywords.Concat(new[] { fullKeywordId });
+
+        // Hier wird jeder Begriff (einzeln und kombiniert) überprüft,
+        // sodass entweder ein neuer Eintrag erstellt oder ein bestehender hochgezählt wird
+        foreach (var keywordId in allKeywordIds)
+        {
+            var entry = await _context.SearchCounts.FindAsync(new object[] { keywordId }, cancellationToken);
+            if (entry == null)
+            {
+                _context.SearchCounts.Add(new SearchCount { KeywordId = keywordId, Count = 1 });
+            }
+            else
+            {
+                entry.Count += 1;
+            }
+        }
+
+        // Hier werden alle Änderungen gespeichert,
+        // sodass die Statistiken dauerhaft in der Datenbank abgelegt sind
+        await _context.SaveChangesAsync(cancellationToken);
+    }
+
+}    
