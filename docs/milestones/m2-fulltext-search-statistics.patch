+  // Diese Methode ruft die Artikelsuche vom Backend auf und gibt die Treffer als Map zurück
+  // Sie verwendet den eingegebenen Suchbegriff (query), eine Seitenbegrenzung (limit) und einen Offset für die Paginierung
+  Future<Map<String, dynamic>> searchArticles(String query, int offset, int limit) async {
+
+    // Hier wird der aktuell eingeloggte Benutzer aus dem lokalen Speicher (Hive) geladen,
+    // um an seinen Token für die Authentifizierung zu kommen
+    Box<UserAccessData>? detailModel = await hiveStore.isExistUserAccessData();
+    final token = detailModel?.values.first.token;
+
+    // Der Suchtext wird so vorbereitet, dass er in der URL erlaubt ist:
+    // Mehrere Begriffe werden durch "+" verbunden (Alle Leerzeichen im Text werden durch "+" ersetzt) und anschließend vollständig URL-kodiert
+    final encodedQuery = Uri.encodeComponent(query.replaceAll(" ", "+"));
+    
+    // Die vollständige URL für die GET-Anfrage an den Search-Endpunkt wird zusammengebaut
+    // Dabei werden Suchbegriff, Offset und Limit als Parameter mitgegeben
+    final url = '${ApiConstant.BASE_URL}${ApiConstant.SUB_URL}/articles/search?query=$encodedQuery&limit=$limit&offset=$offset';
+
+      // Die HTTP-Anfrage wird abgeschickt, inklusive Token im Header zur Authentifizierung
+    final response = await http.get(
+      Uri.parse(url),
+      headers: {
+        'Authorization': 'Bearer $token', // JWT-Token für Zugriffsschutz
+        'Accept': 'application/json',     // Antwortformat: JSON
+      },
+    );
+
+    // Wenn der Server erfolgreich geantwortet hat (HTTP 200 OK),
+    // werden die Artikel und die Gesamtanzahl aus der Antwort extrahiert und zurückgegeben
+    if (response.statusCode == 200) {
+      final Map<String, dynamic> jsonData = json.decode(response.body);
+      return {
+        'articles': List<AllArticlesModel>.from(
+          jsonData["articles"].map((e) => AllArticlesModel.fromJson(e)), // Jeder Artikel wird ins Datenmodell konvertiert
+        ),
+        'articlesCount': jsonData["articlesCount"], // Anzahl aller Treffer
+      };
+    }
+    // Wenn kein gültiger Token vorhanden ist, wird ein Fehler ausgelöst
+     else if (response.statusCode == 401) {
+      throw Exception("Unauthorized");
+    } 
+    // Für alle anderen HTTP-Fehlercodes wird ebenfalls ein Fehler geworfen
+    else {
+      throw Exception("Search failed with status: ${response.statusCode}"); // Fehler mit Statuscode anzeigen
+    }
+  }
+
+}
