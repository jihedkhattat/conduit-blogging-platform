+}
+
+/* Stil für Fehlermeldungen */
+.error-message {
+  color: red; /* Rote Schriftfarbe */
+  margin: 1rem 0; /* Abstand oben und unten */
+}
+
+/* Stil für Ladehinweis */
+.loading {
+  font-style: italic; /* Kursivschrift */
+  color: #555; /* Graue Schriftfarbe */
+}
+</style>
+<!------------------------------------------>
