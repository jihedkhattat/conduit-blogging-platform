+    // In dieser Methode wird eine Volltextsuche über alle Artikel durchgeführt,
+    // wobei der Suchbegriff in mehrere Keywords zerlegt wird
+    public async Task<ArticlesResponseDto> SearchArticlesAsync(string query, int limit, int offset, string username, CancellationToken cancellationToken)
+    {
+        
+        // Nur bei der ersten Seite (offset = 0) wird die Suchanfrage gezählt,
+        // sodass Mehrfachzählungen bei der Navigation über die Ergebnisse vermieden werden (Paginierung)
+        if (offset == 0){
+            await TrackSearchAsync(query, cancellationToken);
+        }
+
+
+        // Der Suchstring wird in einzelne Wörter zerlegt und in Kleinbuchstaben umgewandelt,
+        // sodass die Suche unabhängig von Groß-/Kleinschreibung funktioniert
+        var keywords = query.Split('+', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
+                            .Select(k => k.ToLowerInvariant())
+                            .ToList();
+
+        // Hier werden zunächst alle Artikel geladen, damit lokal gefiltert werden kann
+        var allArticles = await _repository.GetAllArticlesAsync(cancellationToken);
+
+        // Die Liste wird so gefiltert, dass alle Keywords als vollständige Wörter
+        // entweder im Titel, im Body oder in den Tags enthalten sein müssen
+        var filtered = allArticles.Where(article =>
+        {
+            var text = (article.Title + " " + article.Body).ToLowerInvariant();
+            var tags = string.Join(" ", article.Tags.Select(t => t.Id)).ToLowerInvariant();
+        
+            return keywords.All(kw =>
+                System.Text.RegularExpressions.Regex.IsMatch(text, $@"\b{System.Text.RegularExpressions.Regex.Escape(kw)}\b") || 
+                System.Text.RegularExpressions.Regex.IsMatch(tags, $@"\b{System.Text.RegularExpressions.Regex.Escape(kw)}\b"));
+        });
+
+        // Anschließend wird nur der Teil der Ergebnisse zurückgegeben, der zur aktuellen Seite gehört (Pagination)
+        var paged = filtered
+            .Skip(offset)
+            .Take(limit)
+            .ToList();
+
+        return new ArticlesResponseDto(paged, filtered.Count());
+    }
+
+
+
+
+    // In dieser Methode wird die aktuelle Suchanfrage gezählt,
+    // sodass Suchstatistiken zu gesuchten Begriffen gespeichert werden
+    public async Task TrackSearchAsync(string query, CancellationToken cancellationToken)
+
+    {
+        // Der Suchbegriff wird in einzelne Wörter zerlegt, bereinigt und sortiert,
+        // sodass doppelte oder leere Begriffe entfernt werden
+        var keywords = query.Split('+', StringSplitOptions.RemoveEmptyEntries)
+                            .Select(k => k.Trim().ToLowerInvariant())
+                            .Where(k => !string.IsNullOrWhiteSpace(k))
+                            .Distinct()
+                            .OrderBy(k => k)
+                            .ToList(); // In Liste umgewandelt
+
+        // Wenn keine gültigen Wörter vorhanden sind, wird abgebrochen
+        if (keywords.Count == 0)
+            return;
+
+        // Zusätzlich wird auch die vollständige Kombination aller Keywords gespeichert,
+        // sodass sowohl Einzelsuchbegriffe als auch zusammengesetzte Suchen gezählt werden können
+        var allKeywordIds = keywords
+            .Append(string.Join('+', keywords))
+            .Distinct();
+
+
+        foreach (var keywordId in allKeywordIds)
+        {
+            // Für jedes Keyword (oder Kombination) wird geprüft, ob bereits ein Zähler existiert
+            var existing = await _repository.GetSearchCountAsync(keywordId, cancellationToken);
+            if (existing == null)
+            {
+                // Wenn nicht, wird ein neuer Eintrag mit Count = 1 erstellt
+                _repository.AddSearchCount(new SearchCount
+                {
+                    KeywordId = keywordId,
+                    Count = 1
+                });
+            }
+            else
+            {
+                // Andernfalls wird der bestehende Zähler um 1 erhöht
+                existing.Count++;
+            }
+        }
+
+        // Abschließend werden alle Änderungen gespeichert, sodass die Zähler in der Datenbank aktualisiert werden
+        await _repository.SaveChangesAsync(cancellationToken);
+    }
+}
