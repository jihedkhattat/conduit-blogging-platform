+//Dieser Code implementiert die Suchseite (`SearchScreen`) einer Flutter-App
+//Benutzer können hier Wörter eingeben, um nach Artikeln zu suchen
+//Die App sendet die Suchanfrage an das Backend, zeigt die Ergebnisse in einer scrollbaren Liste an und unterstützt Pagination 
+//(Seitenwechsel), Ladeanzeige, Fehlermeldungen bei Internetproblemen und Aktualisierung per Pull-to-Refresh
+//Alle Anfragen werden über das Repository `AllArticlesImpl` abgewickelt
+
+
+import 'package:conduit/model/all_article_model.dart';
+import 'package:conduit/repository/all_article_repo.dart';
+import 'package:conduit/utils/AppColors.dart';
+import 'package:conduit/utils/message.dart';
+import 'package:conduit/widget/all_article_widget.dart';
+import 'package:conduit/widget/no_internet.dart';
+import 'package:conduit/utils/theme_container.dart';
+import 'package:flutter/material.dart';
+
+// Diese StatefulWidget-Klasse bildet die Suchseite ab, da hier der Zustand (z.B Ladeanzeige, Ergebnisse) dynamisch ist
+class SearchScreen extends StatefulWidget {
+  // Hier wird die Route für den Suchbildschirm definiert, um sie im Routing-System aufzurufen
+  static const searchUrl = '/search';
+  const SearchScreen({Key? key}) : super(key: key);
+
+  @override
+  State<SearchScreen> createState() => _SearchScreenState();  // Hier wird das Such-Widget mit optionalem Key-Parameter erstellt
+}
+
+// In dieser Klasse wird der Zustand der Suchseite verwaltet
+class _SearchScreenState extends State<SearchScreen> {
+  // Dieser boolesche Wert gibt an, ob ein Verbindungsfehler (z.B kein Internet) vorliegt
+  bool isNoInternet = false;
+
+  // Dieser Wert zeigt an, ob die Anwendung gerade eine Suchanfrage verarbeitet
+  bool isLoading = false;
+
+  // Diese Variable speichert, ob bereits eine Suchanfrage durchgeführt wurde
+  bool isSearchPerformed = false;
+
+  // Diese Variable speichert die aktuelle Seite für die Paginierung
+  int currentPage = 1;
+
+  // Diese Konstante gibt an, wie viele Artikel pro Seite geladen werden sollen
+  int limit = 10;
+
+  // Diese Variable speichert die Gesamtanzahl der gefundenen Artikel
+  int totalCount = 0;
+
+  // Hier wird der aktuelle Suchbegriff gespeichert, der aus dem Eingabefeld stammt
+  String query = "";
+
+  // Diese Liste enthält die Suchergebnisse als Artikelobjekte
+  List<AllArticlesModel> articles = [];
+
+  // Dieses Textfeld-Element erlaubt es, die Benutzereingabe im Suchfeld zu erfassen und zu verarbeiten
+  final TextEditingController controller = TextEditingController();
+
+  // Mit dieser Methode wird eine neue Suche gestartet, indem der Text aus dem Eingabefeld übernommen wird
+  void startNewSearch() {
+    // Wenn das Eingabefeld leer ist, wird die Suche nicht gestartet
+    if (controller.text.trim().isEmpty) return;
+
+    setState(() {
+      // Hier wird der eingegebene Suchtext vorbereitet, indem mehrere Leerzeichen durch "+" ersetzt werden
+      query = controller.text.trim().replaceAll(RegExp(r'\s+'), '+');
+
+      // Die Seitennummer wird zurückgesetzt, damit die Suche auf der ersten Seite beginnt
+      currentPage = 1;
+
+      // Diese Variable wird auf true gesetzt, um anzuzeigen, dass eine Suche erfolgt ist
+      isSearchPerformed = true;
+    });
+
+    // Anschließend wird die eigentliche Suchlogik aufgerufen
+    performSearch();
+  }
+
+  // Diese Methode ruft die Artikel vom Server ab und verarbeitet die Ergebnisse
+  Future<void> performSearch() async {
+    try {
+      // Zunächst wird der Ladezustand aktiviert und vorherige Fehler zurückgesetzt
+      setState(() {
+        isLoading = true;
+        isNoInternet = false;
+      });
+
+      // Der Offset wird basierend auf der aktuellen Seite berechnet
+      final offset = (currentPage - 1) * limit;
+
+      // Hier wird die Suchfunktion aus dem Repository aufgerufen, um die Daten von der API abzurufen
+      final result = await AllArticlesImpl().searchArticles(query, offset, limit);
+
+      // Nach erfolgreichem Abruf werden die Artikel und die Gesamtanzahl gespeichert
+      setState(() {
+        articles = result['articles'];
+        totalCount = result['articlesCount'];
+        isLoading = false;
+      });
+    } catch (e) {
+      // Bei einem Fehler (z.B Netzwerkproblem) wird ein Fehlerzustand gezeigt
+      print("Search error: $e");
+      setState(() {
+        isNoInternet = true;
+        isLoading = false;
+      });
+    }
+  }
+
+  // Diese Methode wird aufgerufen, um zur nächsten Seite zu wechseln
+  void nextPage() {
+    // Wenn weitere Seiten vorhanden sind, wird die aktuelle Seite erhöht und die Suche erneut durchgeführt
+    if ((currentPage * limit) < totalCount) {
+      setState(() => currentPage++);
+      performSearch();
+    }
+  }
+
+  // Diese Methode wird aufgerufen, um zur vorherigen Seite zu wechseln
+  void prevPage() {
+    if (currentPage > 1) {
+      setState(() => currentPage--);
+      performSearch();
+    }
+  }
+
+  // Diese Methode baut das UI der Seite auf
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      // Hier wird die App-Leiste mit dem Titel und einem Suchsymbol aufgebaut
+      appBar: AppBar(
+        title: Text("Search Articles"),
+        backgroundColor: AppColors.primaryColor, // Farbe aus Designsystem
+        actions: [
+          // Such-Icon wird oben rechts angezeigt
+          IconButton(
+            icon: Icon(Icons.search),
+            onPressed: startNewSearch, // Ein Klick startet die Suche
+          )
+        ],
+      ),
+
+      // Der Inhalt der Seite wird in einem speziellen Container dargestellt
+      body: ThemeContainer(
+        child: isNoInternet
+            // Wenn kein Internet vorhanden ist, wird eine Retry-Komponente angezeigt
+            ? NoInternet(onClickRetry: performSearch)
+            : SafeArea(
+                // Sorgt dafür, dass Inhalte nicht unter Statusleiste oder Notch landen
+                child: Padding(
+                  padding: const EdgeInsets.all(16.0),
+                  child: Column(
+                    children: [
+                      // Dieses Textfeld wird verwendet, damit der Benutzer Suchbegriffe eingeben kann
+                      TextField(
+                        controller: controller, // Steuert Eingabe
+                        decoration: InputDecoration(
+                          hintText: "Enter keywords...", // Platzhaltertext
+                          suffixIcon: IconButton(
+                            icon: Icon(Icons.clear),
+                            onPressed: () => controller.clear(), // Löscht die Eingabe
+                          ),
+                        ),
+                        onSubmitted: (_) => startNewSearch(), // Auch Enter-Taste startet die Suche
+                      ),
+                      SizedBox(height: 10),
+
+                      // Wenn die Suche durchgeführt wurde und Treffer vorliegen, wird die Anzahl angezeigt
+                      if (isSearchPerformed && totalCount > 0)
+                        Padding(
+                          padding: const EdgeInsets.only(bottom: 8.0),
+                          child: Text(
+                            "$totalCount Artikel gefunden.",
+                            style: TextStyle(fontWeight: FontWeight.bold),
+                          ),
+                        ),
+
+                      // Während die Artikel geladen werden, wird ein Ladesymbol angezeigt
+                      if (isLoading)
+                        Center(child: CToast.instance.showLoader())
+
+                      // Wenn keine Artikel gefunden wurden, wird dies als Nachricht angezeigt
+                      else if (articles.isEmpty && isSearchPerformed)
+                        Text("No articles found.")
+
+                      // Wenn Artikel vorhanden sind, wird eine Liste angezeigt
+                      else
+                        Expanded(
+                          child: RefreshIndicator(
+                            onRefresh: performSearch, // Wenn der Nutzer die Liste nach unten zieht, wird die Suche erneut gestartet
+                            child: ListView.separated(
+                              itemCount: articles.length, // Gibt an, wie viele Artikel in der Liste angezeigt werden
+                              itemBuilder: (context, index) => AllAirtistWidget(
+                                articlesModel: articles[index], // Hier wird ein einzelner Artikel an das Widget übergeben
+                                onRefresh: performSearch, // Diese Funktion wird aufgerufen, wenn das Widget aktualisiert werden soll
+                              ),
+                              separatorBuilder: (_, __) => SizedBox(height: 10), // Abstand zwischen Artikeln
+                            ),
+                          ),
+                        ),
+
+                      // Wenn Artikel gibt, erscheinen auch Buttons zur Seitennavigation
+                      if (articles.isNotEmpty)
+                        Padding(
+                          padding: const EdgeInsets.symmetric(vertical: 10),
+                          child: Row(
+                            mainAxisAlignment: MainAxisAlignment.center,
+                            children: [
+                              ElevatedButton(
+                                onPressed: prevPage,
+                                child: Text("Prev"), // Zurück zur vorherigen Seite
+                              ),
+                              SizedBox(width: 10),
+                              Text("Page $currentPage"), // Aktuelle Seitennummer
+                              SizedBox(width: 10),
+                              ElevatedButton(
+                                onPressed: nextPage,
+                                child: Text("Next"), // Weiter zur nächsten Seite
+                              ),
+                            ],
